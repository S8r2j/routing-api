# Copy this file to .env and fill in values before starting the server.
# python-decouple reads .env automatically — no export needed.

# -----------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------

# Set to False in production.
DEBUG=True

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------

# Leave unset to use SQLite (default for development).
# Set to a PostgreSQL URL for production, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/fuel_route
DATABASE_URL=

# -----------------------------------------------------------------------
# Cache / Redis
# -----------------------------------------------------------------------

# Leave unset to use the no-Redis fallback:
#   - Route responses cached in per-worker LocMemCache (fast, in-memory).
#   - Throttle counters stored in FileBasedCache (shared across all workers).
# Set to a Redis URL in production to share both caches across workers:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# -----------------------------------------------------------------------
# Throttling
# -----------------------------------------------------------------------

# Max requests per IP per time window for anonymous (unauthenticated) clients.
# Format: {number}/{period} where period is second, minute, hour, or day.
# Examples: 60/minute, 1000/hour, 5000/day
THROTTLE_RATE_ANON=60/minute

# -----------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------

# Set to True to allow requests from any origin (suitable for public APIs).
# Set to False and define CORS_ALLOWED_ORIGINS to restrict to specific domains.
CORS_ALLOW_ALL_ORIGINS=True

# Comma-separated list of allowed origins. Only used when CORS_ALLOW_ALL_ORIGINS=False.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------
# OSRM routing service
# -----------------------------------------------------------------------

# Base URL of the OSRM instance. Defaults to the public demo server.
# Replace with a self-hosted instance URL in production for reliability.
OSRM_BASE_URL=http://router.project-osrm.org

# Seconds to wait for OSRM before timing out and returning a 504.
OSRM_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------
# Route cache
# -----------------------------------------------------------------------

# How long (in seconds) to cache a completed route response.
# Repeated identical start/end queries are served from cache within this window.
# Default: 3600 (1 hour)
ROUTE_CACHE_TIMEOUT=3600

# -----------------------------------------------------------------------
# Vehicle parameters
# -----------------------------------------------------------------------

# Maximum driving range on a full tank, in miles.
# Tank capacity in gallons is derived as VEHICLE_TANK_RANGE_MILES / VEHICLE_MPG.
# Default: 500 miles (50-gallon tank at 10 mpg)
VEHICLE_TANK_RANGE_MILES=500

# Fuel efficiency of the vehicle in miles per gallon.
# Default: 10 mpg
VEHICLE_MPG=10
